#include <winres.h>
#include "ResourceIds.h"

// The application icon. Shown on the settings window and used as the tray
// icon fallback; the running tray icon is drawn from the live category colors.
IDI_APP ICON "app.ico"

// Version 1.0.N, N = CI build number (vcxproj BuildNumber -> APP_BUILD).
#ifndef APP_BUILD
#define APP_BUILD 0
#endif
#define APP_STR2(x) #x
#define APP_STR(x) APP_STR2(x)
#define APP_VERSION_STR "1.0." APP_STR(APP_BUILD)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,APP_BUILD,0
 PRODUCTVERSION 1,0,APP_BUILD,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Desktop hardware widget (tray)"
			VALUE "FileVersion", APP_VERSION_STR
			VALUE "InternalName", "DesktopWidget"
			VALUE "OriginalFilename", "DesktopWidget.exe"
			VALUE "ProductName", "DesktopWidget"
			VALUE "ProductVersion", APP_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
